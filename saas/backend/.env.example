# Murici SaaS External Links - Environment Variables Template

# Application Configuration
NODE_ENV=production
PORT=3001
JWT_SECRET=your-super-secure-jwt-secret-key-here

# Database Connection (same as main system)
DATABASE_URL=postgresql://username:password@host:port/database

# CORS Configuration
ALLOWED_ORIGINS=https://murici-saas.replit.app,https://external.muricifleet.com

# Security Settings
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Monitoring
ENABLE_MONITORING=true
LOG_LEVEL=info

# Optional: Custom Domain
CUSTOM_DOMAIN=external.muricifleet.com

# Optional: Redis for session storage (if needed)
# REDIS_URL=redis://localhost:6379